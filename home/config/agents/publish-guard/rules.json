{
  "commands": {
    "git": { "dir_option": "-C", "value_options": ["-c"] }
  },
  "rules": [
    { "cmd": "git", "sub": ["push"], "target": "git-remote" },
    {
      "cmd": "gh",
      "sub": ["pr", "issue"],
      "act": ["create", "edit", "merge", "comment", "close", "reopen", "review", "ready", "delete", "lock", "unlock", "develop", "transfer"],
      "target": "gh-repo"
    },
    { "cmd": "gh", "sub": ["release"], "act": ["create", "edit", "upload", "delete", "delete-asset"], "target": "gh-repo" },
    { "cmd": "gh", "sub": ["repo"], "act": ["edit", "delete", "rename", "archive", "unarchive", "sync", "deploy-key"], "target": "gh-repo" },
    { "cmd": "gh", "sub": ["repo"], "act": ["create", "fork"], "target": "none" },
    { "cmd": "gh", "sub": ["gist"], "act": ["create", "edit", "delete"], "target": "none" },
    { "cmd": "gh", "sub": ["api"], "target": "gh-api" },
    { "cmd": "fj", "sub": ["pr", "issue"], "act": ["create", "edit", "merge", "comment"], "target": "origin" },
    { "cmd": "fj", "sub": ["release"], "act": ["create"], "target": "origin" },
    { "cmd": "fj", "sub": ["repo"], "act": ["create"], "target": "none" }
  ]
}
